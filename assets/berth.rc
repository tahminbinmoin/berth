#pragma code_page(65001)
#include <winres.h>

1 ICON "berth.ico"
1 RT_MANIFEST "berth.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,4,0
 PRODUCTVERSION 0,1,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Berth contributors"
            VALUE "FileDescription", "Berth dock"
            VALUE "FileVersion", "0.1.4"
            VALUE "InternalName", "Berth"
            VALUE "LegalCopyright", "Copyright (c) 2026 Tahmin Bin Moin and Berth contributors. MIT License."
            VALUE "OriginalFilename", "Berth.exe"
            VALUE "ProductName", "Berth"
            VALUE "ProductVersion", "0.1.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
